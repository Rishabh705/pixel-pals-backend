# Ignore node_modules (Docker will install dependencies inside the container)
node_modules

# Ignore environment files (these should be passed at runtime)
.env
.env*

# Ignore logs
logs
*.log

# Ignore sensitive keys
keys

# Ignore system files
.DS_Store
Thumbs.db

# Ignore npm debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore Docker-specific files
docker-compose.yml
Dockerfile
